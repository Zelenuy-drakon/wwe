<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="StoreDB" 
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=OnlineStoreDB;Integrated Security=True;TrustServerCertificate=True;" 
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>